<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PlotView</AssemblyName>
    <RootNamespace>PlotView</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>PlotView</Product>
    <Description>CAD처럼 조작하는 PDF 도면 뷰어</Description>
    <Copyright>Copyright (c) 2026 GiJungPark</Copyright>
    <Version>1.0.0</Version>

    <!-- 설치 PC에 .NET이 없어도 실행되도록 런타임 포함 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- 크롬의 PDF 엔진 PDFium (BSD/Apache 라이선스). pdfium.dll이 함께 배포됨 -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="*" />
  </ItemGroup>

</Project>
